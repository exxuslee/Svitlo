<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent body: the launcher's wallpaper remains visible underneath. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_bubble_corner_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#542E3138"
                android:endColor="#6622242A"
                android:startColor="#7A484C55"
                android:type="linear" />
        </shape>
    </item>
    <!-- A soft reflection and a light rim give the bubble a glass surface. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_bubble_corner_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.35"
                android:endColor="#08FFFFFF"
                android:startColor="#24FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
