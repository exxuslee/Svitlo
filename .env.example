# Copy to .env in the project root and uncomment all four settings.
# Use your existing upload key. Prefer an absolute path with forward slashes.
# Values may be quoted. Do not add inline comments or use variable expansion.
# Environment variables override these settings.
# ANDROID_KEYSTORE_PATH=D:/secure/svitlo-upload.jks
# ANDROID_KEYSTORE_PASSWORD=replace_with_store_password
# ANDROID_KEY_ALIAS=replace_with_key_alias
# ANDROID_KEY_PASSWORD=replace_with_key_password
